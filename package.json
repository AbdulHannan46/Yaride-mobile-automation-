{
  "name": "yride-android-automation",
  "version": "1.0.0",
  "description": "Production-quality Android mobile automation framework for YRide using WebdriverIO, Appium, TypeScript, and Cucumber BDD",
  "main": "config/wdio.conf.ts",
  "type": "module",
  "scripts": {
    "test": "wdio run config/wdio.conf.ts",
    "test:auth": "wdio run config/wdio.conf.ts --spec src/test/resources/features/authentication/**/*.feature",
    "test:login": "wdio run config/wdio.conf.ts --spec src/test/resources/features/authentication/login.feature",
    "test:signup": "wdio run config/wdio.conf.ts --spec src/test/resources/features/authentication/signup.feature",
    "test:navigation": "wdio run config/wdio.conf.ts --spec src/test/resources/features/navigation/bottom-navigation.feature",
    "test:smoke": "wdio run config/wdio.conf.ts --cucumberOpts.tags=\"@smoke\"",
    "test:debug": "wdio run config/wdio.conf.ts --logLevel debug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report:generate": "allure generate allure-results --clean -o reports/allure-report",
    "report:single": "allure generate allure-results --single-file --clean -o reports/allure-report-single",
    "report:open": "allure open reports/allure-report",
    "report:clean": "node -e \"const fs=require('fs'); fs.rmSync('allure-results', {recursive:true, force:true}); fs.rmSync('reports/allure-report', {recursive:true, force:true}); fs.mkdirSync('allure-results', {recursive:true}); fs.writeFileSync('allure-results/.gitkeep', '# allure results\\n');\""
  },
  "keywords": [
    "appium",
    "webdriverio",
    "cucumber",
    "typescript",
    "android",
    "bdd",
    "screen-object-model"
  ],
  "author": "SDET Team",
  "license": "ISC",
  "dependencies": {
    "webdriverio": "^9.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/cucumber-framework": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "glob": "^11.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.1"
  }
}
