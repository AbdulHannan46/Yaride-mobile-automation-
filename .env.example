# ==================================================
# YRide Android Automation Framework - Environment Configuration
# ==================================================
# Copy this file to .env for local overrides.
# DO NOT COMMIT REAL CREDENTIALS OR SENSITIVE DATA.

# Appium Server Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/

# Android Device & Application Configuration
# Leave blank to auto-detect first connected device/emulator, or provide specific UDID
ANDROID_DEVICE_UDID=your_device_udid_here
ANDROID_AUTOMATION_NAME=UiAutomator2
ANDROID_APP_PACKAGE=com.jarental.jarental
ANDROID_APP_ACTIVITY=com.jarental.jarental.MainActivity
ANDROID_NO_RESET=true

# Execution Timeouts (milliseconds)
EXPLICIT_WAIT_TIMEOUT=15000
NEW_COMMAND_TIMEOUT=240

# Logging Level (trace | debug | info | warn | error | silent)
LOG_LEVEL=info

# Test Account Credentials (Populate in your local .env, NEVER commit .env to Git)
YRIDE_TEST_EMAIL=testuser@example.com
YRIDE_TEST_PASSWORD=your_secure_password_here

